# PostgreSQL (installed directly on the EC2 host)
# host.docker.internal resolves to the EC2 host from inside the Docker container
# This requires PostgreSQL to be installed on the EC2 itself (not as a container)
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=erp
DB_PASS=erp_pass
DB_NAME=core_db
DB_SSL=false

# S3-compatible object storage (Backblaze B2 / Cloudflare R2 / MinIO)
#
# --- Backblaze B2 setup ---
# 1. Create a bucket: backblaze.com → B2 Cloud Storage → Create a Bucket
# 2. Note the endpoint shown on the bucket detail page, e.g.:
#       https://s3.us-west-002.backblazeb2.com
# 3. Create an App Key: B2 → App Keys → Add a New Application Key
#    (set permissions to Read and Write for your bucket)
# 4. Copy the keyID → STORAGE_ACCESS_KEY_ID
#    Copy the applicationKey → STORAGE_SECRET_ACCESS_KEY














STORAGE_ENDPOINT=https://s3.us-west-002.backblazeb2.com
STORAGE_REGION=us-west-002
STORAGE_ACCESS_KEY_ID=your_key_id_here
STORAGE_SECRET_ACCESS_KEY=your_application_key_here
STORAGE_BUCKET=your-bucket-name-here

# Public base URL — only set if the bucket is public.
# B2 format: https://f002.backblazeb2.com/file/<bucket-name>
# Or use a custom domain if configured.
# Leave empty to use presigned GET URLs (works for private buckets).
STORAGE_PUBLIC_URL_BASE=

# Mail / SMTP (NodeMailer)
# MAIL_USER and MAIL_PASSWORD are required — the service won't send without them.
# For Gmail: enable 2FA, then generate an App Password at
#   https://myaccount.google.com/apppasswords  (use that as MAIL_PASSWORD)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_FROM=your_email@gmail.com

# Centrifugo — real-time WebSocket push notifications
# CENTRIFUGAL_SECRET_KEY: HMAC secret used to sign client connection JWTs (must match Centrifugo token_hmac_secret_key)
# CENTRIFUGAL_API_KEY: HTTP API key for server-side publish calls (X-API-Key header)
# CENTRIFUGAL_API_URL: Base URL of your Centrifugo server (no trailing slash)
CENTRIFUGAL_SECRET_KEY=your_centrifugo_token_hmac_secret_here
CENTRIFUGAL_API_KEY=your_centrifugo_http_api_key_here
CENTRIFUGAL_API_URL=http://localhost:8001
